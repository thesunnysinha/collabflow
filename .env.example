# Copy to .env at the repo root and fill in. Never commit .env.

# Public hostname served over HTTPS by Caddy (automatic Let's Encrypt). Use "localhost" locally.
DOMAIN=localhost

# production | development
NODE_ENV=production

# Generate with: openssl rand -hex 32   (use hex so no URL-escaping is needed in MONGO_URI)
JWT_SECRET=
MONGO_USER=collabflow
MONGO_PASSWORD=

# Extra allowed browser origins (comma-separated). Leave empty: the app is served same-origin.
CORS_ORIGINS=
