# Copy to .env at the repo root and fill in. Never commit .env.

# Public hostname served over HTTPS by Caddy (automatic Let's Encrypt). Use "localhost" locally.
DOMAIN=localhost

# production | development
NODE_ENV=production

# Generate with: openssl rand -hex 32   (use hex so no URL-escaping is needed in MONGO_URI)
JWT_SECRET=
MONGO_USER=collabflow
MONGO_PASSWORD=

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps > New).
#   Homepage URL:      https://<DOMAIN>
#   Authorization callback URL: https://<DOMAIN>/api/v1/auth/github/callback
# For local development register a second app with callback http://localhost:3000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Extra allowed browser origins (comma-separated). Leave empty: the app is served same-origin.
CORS_ORIGINS=
