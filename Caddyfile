# Edge proxy: automatic HTTPS (Let's Encrypt), HTTP->HTTPS redirect, WebSocket upgrade.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /socket.io/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:8080
	}
}
